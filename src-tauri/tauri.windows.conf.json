{
  "identifier": "com.stone.tTerm",
  "bundle": {
    "resources": {
      "resources/conpty/conpty.dll": "conpty.dll",
      "resources/conpty/OpenConsole.exe": "OpenConsole.exe",
      "resources/conpty-LICENSE.txt": "conpty-LICENSE.txt"
    },
    "windows": {
      "nsis": {
        "installerHooks": "./windows/hooks.nsh"
      }
    }
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "tTerm",
        "label": "main",
        "create": false,
        "decorations": false,
        "transparent": true,
        "visibleOnAllWorkspaces": true
      }
    ]
  }
}
